# Spring reads process environment variables, not this file automatically.
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Generate at least 32 random bytes and Base64 encode them; no default secret.
JWT_SECRET=
# Keep true with HTTPS; false only for local HTTP development.
AUTH_COOKIE_SECURE=true
# Enable local API docs explicitly; disabled by default.
API_DOCS_ENABLED=false
# Keep enabled for automatic contract start/expiry and occupancy reconciliation.
CONTRACT_SCHEDULER_ENABLED=true
# Evaluate in-app notifications after committed writes and reconcile date-based alerts every minute.
ALERT_EVENTS_ENABLED=true
ALERT_SCHEDULER_ENABLED=true
# SQL authentication: set a dedicated database login and password.
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=holoka_newconcept;encrypt=true;trustServerCertificate=false
DB_USERNAME=
DB_PASSWORD=
# Local Windows authentication alternative (requires -Pwindows-auth and native DLL):
# DB_URL=jdbc:sqlserver://localhost:1433;databaseName=holoka_newconcept;encrypt=true;trustServerCertificate=true;integratedSecurity=true
# trustServerCertificate=true is only for the local development self-signed certificate.
# Real SQL Server integration tests require a separate database:
TEST_DB_URL=jdbc:sqlserver://localhost:1433;databaseName=holoka_newconcept_it;encrypt=true;trustServerCertificate=false
TEST_DB_USERNAME=
TEST_DB_PASSWORD=
